{
  "name": "Mail",
  "name_prefix": "Twake",
  "slug": "mail",
  "version": "1.10.0",
  "type": "webapp",
  "licence": "AGPL-3.0",
  "icon": "assets/icon.svg",
  "categories": ["cozy"],
  "source": "https://github.com/cozy/cozy-twakemail",
  "editor": "Cozy",
  "developer": {
    "name": "Twake Workplace",
    "url": "https://twake.app"
  },
  "client_url_flag": "mail.embedded-app-url",
  "routes": {
    "/": {
      "folder": "/",
      "index": "index.html",
      "public": false
    }
  },
  "permissions": {
    "banners": {
      "description": "Required by the cozy-bar to display platform messages",
      "type": "io.cozy.banners",
      "verbs": ["GET", "PUT"]
    },
    "apps": {
      "description": "Required by the cozy-bar to display the icons of the apps",
      "type": "io.cozy.apps",
      "verbs": ["GET"]
    },
    "settings": {
      "description": "Required by the cozy-bar to display storage usage",
      "type": "io.cozy.settings",
      "verbs": ["GET"]
    },
    "filesGet": {
      "description": "Required to get shortcuts",
      "type": "io.cozy.files",
      "verbs": ["GET"],
      "selector": "name",
      "values": ["Home"]
    },
    "filesPost": {
      "description": "Required to upload attachments in the Mail magic folder",
      "type": "io.cozy.files",
      "verbs": ["POST"],
      "selector": "referenced_by",
      "values": ["io.cozy.apps/mail"]
    },
    "filesGetTmp": {
      "description": "TEMPORARY PERMISSIONS TO BE ABLE TO CREATE SHARING LINKS",
      "type": "io.cozy.files",
      "verbs": ["GET"]
    }
  },
  "mobile": {
    "schema": "twakemail.mobile://openApp",
    "id_playstore": "com.linagora.android.teammail",
    "id_appstore": "twake-mail/id1587086189"
  }
}
